  "bugs": {
    "url": "https://github.com/flowtsohg/mdx-m3-viewer/issues"
  },
  "homepage": "https://github.com/flowtsohg/mdx-m3-viewer#readme",
  "dependencies": {
    "@types/three": "^0.182.0",
    "fengari": "^0.1.4",
    "gl-matrix": "3.3.0",
    "pako": "^2.0.3",
    "pngjs": "^7.0.0",
    "tga-js": "^1.1.1",
    "three": "^0.182.0",
    "war3-model": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^12.12.17",
    "@types/pako": "^1.0.2",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^4.30.0",
    "@typescript-eslint/parser": "^4.30.0",
    "eslint": "^7.29.0",
    "ts-loader": "^9.2.3",
    "typescript": "^4.3.5",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.7.2",
    "webpack-dev-server": "^3.11.2"
  }
}
